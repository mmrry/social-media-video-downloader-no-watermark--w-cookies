# Telegram Bot Token (@BotFather); API_ID / API_HASH — my.telegram.org
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash

ADMIN_IDS=123456789,987654321

# Лимит файла. Облачный Bot API — 50 MB, локальный Bot API (--local) — 2000 MB.
# В docker-compose.yml переопределяется на 2000.
MAX_FILE_SIZE_MB=2000
# Порог предупреждения «файл большой, продолжить?»
WARNING_THRESHOLD_MB=1024
DISK_RESERVE_MB=100

DOWNLOAD_DIR=/app/downloads

# Cookies в формате Netscape
COOKIES_FILE=/app/cookies.txt          # Instagram — обязательно
VK_COOKIES_FILE=                       # VK — опционально, напр. /app/vk_cookies.txt

# Совместимость видео с Telegram
PREFER_H264=1
TRANSCODE_NON_H264=1
TRANSCODE_MAX_MB=300

COOLDOWN_SECONDS=5
MAX_CONCURRENT_DOWNLOADS=3
PENDING_URL_TTL=3600
