# Telegram Bot Token (@BotFather); API_ID / API_HASH — my.telegram.org
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash

ADMIN_IDS=123456789,987654321

# Ежедневный отчёт в личку ADMIN_IDS: кто пользовался ботом и какие ссылки отправлял.
# Каждый админ должен хотя бы раз написать боту /start. /report — отчёт за сегодня.
DAILY_REPORT=0
DAILY_REPORT_TIME=09:00
DAILY_REPORT_TZ=Europe/Moscow

# Бот в контейнере работает не от root. Этому UID/GID должны принадлежать
# ./downloads и cookies.txt на хосте:  sudo chown -R 1000:1000 downloads cookies.txt
# После изменения — пересобрать образ: docker compose build bot
APP_UID=1000
APP_GID=1000

# Лимит файла. Облачный Bot API — 50 MB, локальный Bot API (--local) — 2000 MB.
# В docker-compose.yml переопределяется на 2000.
MAX_FILE_SIZE_MB=2000
# Порог предупреждения «файл большой, продолжить?»
WARNING_THRESHOLD_MB=1024
DISK_RESERVE_MB=100

DOWNLOAD_DIR=/app/downloads

# Cookies в формате Netscape
COOKIES_FILE=/app/cookies.txt          # Instagram — обязательно
VK_COOKIES_FILE=                       # VK — опционально, напр. /app/vk_cookies.txt
VIMEO_COOKIES_FILE=                    # Vimeo — опционально (видео только для вошедших), /app/vimeo_cookies.txt

# Совместимость видео с Telegram
PREFER_H264=1
TRANSCODE_NON_H264=1
TRANSCODE_MAX_MB=300

COOLDOWN_SECONDS=5
MAX_CONCURRENT_DOWNLOADS=3
PENDING_URL_TTL=3600
# Фото-посты Instagram/TikTok: максимум элементов из одного поста (альбомы по 10)
GALLERY_MAX_ITEMS=35
# Музыка слайд-шоу TikTok в MP3: button (кнопка после альбома) / auto (сразу) / off
SLIDESHOW_AUDIO=button

# --- Сеть (по умолчанию выключено) ---
# Если vk.com недоступен с сервера, а vk.ru доступен — слать API-запросы VK туда
VK_API_HOST=
# Прокси для yt-dlp: http://host:port или socks5://user:pass@host:port
PROXY=
VK_PROXY=
# IPv4 принудительно (если IPv6-коннекты висят до таймаута)
FORCE_IPV4=0
SOCKET_TIMEOUT=30

